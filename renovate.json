{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "customManagers:helmChartYamlAppVersions"],
  "packageRules": [
    {
      "description": "Bump Chart.yaml version when an image in this chart changes, so chart-releaser publishes",
      "matchFileNames": ["charts/**"],
      "bumpVersions": [
        {
          "filePatterns": ["{{packageFileDir}}/Chart.yaml"],
          "matchStrings": ["(?:^|\\n)version:\\s+(?<version>\\S+)"],
          "bumpType": "{{#if isPatch}}patch{{else}}minor{{/if}}"
        }
      ]
    }
  ]
}
